# ==============================================================================
# SIPHONIX SERVER CONFIGURATION
# ==============================================================================

# Network Interfaces & Routing
SERVER_NAME=Siphonix-Server/3.0
HOST=0.0.0.0
REALM=localhost

# SIP Protocol Ports
SIP_PORT_UDP=5070
SIP_PORT_TLS=5071
ENABLE_TLS=false

# Administration Web Console
WEB_ADMIN_PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Storage & TLS Certificates
DB_FILE=siphonix.db
CERT_FILE=server.crt
KEY_FILE=server.key

# RTP Port Allocation Range
RTP_START_PORT=10000
RTP_END_PORT=20000